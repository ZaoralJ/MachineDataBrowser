<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MachineDataBrowser.App.ViewModels"
        x:Class="MachineDataBrowser.App.Views.MonitoringSettingsWindow"
        x:DataType="vm:MonitoringSettingsViewModel"
        Title="Monitoring settings"
        Icon="/Assets/AppIcon.png"
        Width="500" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="14">
    <StackPanel Spacing="2">
      <TextBlock Text="{Binding Target}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
      <TextBlock FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap"
                 Text="{Binding RefreshText, StringFormat='Values are published every {0} (the refresh time).'}" />
    </StackPanel>

    <StackPanel Spacing="6">
      <CheckBox Content="Own sampling interval" IsChecked="{Binding UseOwnSampling}" />
      <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding UseOwnSampling}" Margin="28,0,0,0">
        <NumericUpDown Value="{Binding SamplingIntervalMs}" Minimum="0" Maximum="3600000" Increment="10" FormatString="0" Width="150"
                       ButtonSpinnerLocation="Right" AutomationProperties.Name="Sampling interval" />
        <TextBlock Text="ms · 0 = as fast as the server can" VerticalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource AppMutedTextBrush}" />
      </StackPanel>
    </StackPanel>

    <StackPanel Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Queue size" VerticalAlignment="Center" Width="120" />
        <NumericUpDown Value="{Binding QueueSize}" Minimum="1" Maximum="100000" Increment="1" FormatString="0" Width="150"
                       ButtonSpinnerLocation="Right" AutomationProperties.Name="Queue size" />
        <CheckBox Content="Discard oldest" IsChecked="{Binding DiscardOldest}" />
      </StackPanel>
      <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedTextBrush}"
                 Text="With a queue, every sample taken between two publishes arrives, not only the last one. These settings apply to Watch; recordings have their own monitored items." />
    </StackPanel>

    <StackPanel Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Deadband" VerticalAlignment="Center" Width="120" />
        <ComboBox ItemsSource="{x:Static vm:MonitoringSettingsViewModel.DeadbandKinds}" SelectedItem="{Binding Deadband}" Width="150"
                  AutomationProperties.Name="Deadband" />
        <NumericUpDown Value="{Binding DeadbandValue}" Minimum="0" Increment="0.1" FormatString="0.###" Width="120"
                       ButtonSpinnerLocation="Right" IsVisible="{Binding HasDeadband}" AutomationProperties.Name="Deadband value" />
      </StackPanel>
      <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedTextBrush}" IsVisible="{Binding HasDeadband}"
                 Text="{Binding DeadbandUnit, StringFormat='Only changes larger than this are reported ({0}).'}" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
      <Button Content="Defaults" Click="OnDefaults" MinWidth="80" ToolTip.Tip="Sample at the refresh time, queue 1, no deadband" />
      <Button Content="Cancel" IsCancel="True" Click="OnCancel" MinWidth="80" />
      <Button Content="Apply" IsDefault="True" Classes="accent" Click="OnApply" MinWidth="80" />
    </StackPanel>
  </StackPanel>
</Window>
