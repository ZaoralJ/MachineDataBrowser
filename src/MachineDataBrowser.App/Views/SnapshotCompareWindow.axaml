<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MachineDataBrowser.App.ViewModels"
        xmlns:services="using:MachineDataBrowser.App.Services"
        xmlns:views="using:MachineDataBrowser.App.Views"
        x:Class="MachineDataBrowser.App.Views.SnapshotCompareWindow"
        x:DataType="vm:SnapshotCompareViewModel"
        Title="Compare with snapshot"
        Icon="/Assets/AppIcon.png"
        Width="980" Height="560" MinWidth="620" MinHeight="300"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TextBlock.changed">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    </Style>
  </Window.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="pane-toolbar" Padding="10,6">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Delete snapshot" Command="{Binding DeleteCommand}" Margin="8,0,0,0"
                ToolTip.Tip="Delete the selected baseline snapshot" />
        <CheckBox DockPanel.Dock="Right" Content="Changed only" IsChecked="{Binding ChangedOnly}" Margin="8,0,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Before" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding Baseline}" MinWidth="240"
                    AutomationProperties.Name="Baseline snapshot" />
          <TextBlock Text="After" VerticalAlignment="Center" Margin="8,0,0,0" />
          <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" MinWidth="240"
                    AutomationProperties.Name="Compare with" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="10,4"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <TextBlock FontSize="12" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
    </Border>
    <Grid>
      <DataGrid ItemsSource="{Binding Rows}" SelectionMode="Extended" AutomationProperties.Name="Differences">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Name" views:GridCopy.Member="Name" Width="200" SortMemberPath="Name">
            <DataTemplate DataType="vm:SnapshotDiffRow">
              <TextBlock Classes="cell" Text="{Binding Name}" ToolTip.Tip="{Binding NodeId}" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Before" views:GridCopy.Member="Before" Width="*" SortMemberPath="Before">
            <DataTemplate DataType="vm:SnapshotDiffRow">
              <TextBlock Classes="cell mono" Text="{Binding Before}" ToolTip.Tip="{Binding BeforeStatus}" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="After" views:GridCopy.Member="After" Width="*" SortMemberPath="After">
            <DataTemplate DataType="vm:SnapshotDiffRow">
              <TextBlock Classes="cell mono" Text="{Binding After}" ToolTip.Tip="{Binding AfterStatus}" Classes.changed="{Binding IsChanged}" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Change" views:GridCopy.Member="ChangeText" Width="120" SortMemberPath="Change">
            <DataTemplate DataType="vm:SnapshotDiffRow">
              <TextBlock Classes="cell mono" Text="{Binding ChangeText}" HorizontalAlignment="Right" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Status before" views:GridCopy.Member="BeforeStatus" Width="140" IsVisible="False">
            <DataTemplate DataType="vm:SnapshotDiffRow">
              <TextBlock Classes="cell" Text="{Binding BeforeStatus}" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Status after" views:GridCopy.Member="AfterStatus" Width="140">
            <DataTemplate DataType="vm:SnapshotDiffRow">
              <TextBlock Classes="cell" Text="{Binding AfterStatus}" />
            </DataTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Classes="empty-hint" IsVisible="{Binding !Rows.Count}"
                 Text="Nothing to show: no differences, or no snapshot yet (Watch ▸ Take Snapshot)." />
    </Grid>
  </DockPanel>
</Window>
