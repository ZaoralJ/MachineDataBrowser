<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MachineDataBrowser.App.ViewModels"
        xmlns:services="using:MachineDataBrowser.App.Services"
        xmlns:core="using:MachineDataBrowser.Core"
        xmlns:views="using:MachineDataBrowser.App.Views"
        x:Class="MachineDataBrowser.App.Views.SnapshotCompareWindow"
        x:DataType="vm:SnapshotCompareViewModel"
        Title="Compare with snapshot"
        Icon="/Assets/AppIcon.png"
        Width="980" Height="560" MinWidth="620" MinHeight="300"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TextBlock.changed">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    </Style>
  </Window.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="pane-toolbar" Padding="10,6">
      <DockPanel>
        <DropDownButton DockPanel.Dock="Right" Content="Snapshot" Margin="8,0,0,0" AutomationProperties.Name="Snapshot actions">
          <DropDownButton.Flyout>
            <MenuFlyout>
              <MenuItem Header="Rename Before…" Command="{Binding StartRenameCommand}"
                        ToolTip.Tip="Give the Before snapshot a meaningful name, e.g. Line 1 – product A" />
              <MenuItem Header="Export Before…" Command="{Binding ExportCommand}"
                        ToolTip.Tip="Save the Before snapshot as a JSON file, e.g. to share a parameter set" />
              <MenuItem Header="Import…" Command="{Binding ImportCommand}"
                        ToolTip.Tip="Add a snapshot file and compare with it" />
              <Separator />
              <MenuItem Header="Delete Before" Command="{Binding DeleteCommand}"
                        ToolTip.Tip="Delete the selected baseline snapshot" />
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
        <Button DockPanel.Dock="Right" Content="Write back…" Command="{Binding RestoreCommand}" Margin="8,0,0,0"
                IsVisible="{Binding CanRestoreAny}"
                ToolTip.Tip="Write the snapshot values of the selected rows (or all changed rows) back to the device" />
        <CheckBox DockPanel.Dock="Right" Content="Changed only" IsChecked="{Binding ChangedOnly}" Margin="8,0,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Before" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding Baseline}" MinWidth="210"
                    AutomationProperties.Name="Baseline snapshot" />
          <TextBlock Text="After" VerticalAlignment="Center" Margin="8,0,0,0" />
          <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" MinWidth="210"
                    AutomationProperties.Name="Compare with" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Top" Padding="10,6" IsVisible="{Binding IsRenaming}"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="Name" VerticalAlignment="Center" Margin="0,0,8,0" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
          <Button Content="Cancel" Command="{Binding CancelRenameCommand}" />
          <Button Content="Rename" Command="{Binding ApplyRenameCommand}" Classes="accent" />
        </StackPanel>
        <TextBox x:Name="RenameBox" Text="{Binding NewName}" AutomationProperties.Name="Snapshot name"
                 KeyDown="OnRenameKeyDown" />
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="10,4"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <StackPanel>
        <TextBlock FontSize="12" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
        <TextBlock FontSize="12" Text="{Binding WriteResult}" TextWrapping="Wrap"
                   IsVisible="{Binding WriteResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="10,8" IsVisible="{Binding IsConfirming}"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <Button Content="Cancel" Command="{Binding CancelRestoreCommand}" IsCancel="True" />
          <Button Content="Write" Command="{Binding ConfirmRestoreCommand}" Classes="accent" />
        </StackPanel>
        <TextBlock Text="{Binding PendingWrite}" TextWrapping="Wrap" AutomationProperties.Name="Write confirmation" />
      </DockPanel>
    </Border>
    <Grid>
      <DataGrid x:Name="Differences" ItemsSource="{Binding Rows}" SelectionMode="Extended" AutomationProperties.Name="Differences"
                SelectionChanged="OnSelectionChanged">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Name" views:GridCopy.Member="Name" Width="200" SortMemberPath="Name">
            <DataTemplate DataType="core:SnapshotDiffRow">
              <TextBlock Classes="cell" Text="{Binding Name}" ToolTip.Tip="{Binding NodeId}" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Before" views:GridCopy.Member="Before" Width="*" SortMemberPath="Before">
            <DataTemplate DataType="core:SnapshotDiffRow">
              <TextBlock Classes="cell mono" Text="{Binding Before}" ToolTip.Tip="{Binding BeforeStatus}" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="After" views:GridCopy.Member="After" Width="*" SortMemberPath="After">
            <DataTemplate DataType="core:SnapshotDiffRow">
              <TextBlock Classes="cell mono" Text="{Binding After}" ToolTip.Tip="{Binding AfterStatus}" Classes.changed="{Binding IsChanged}" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Change" views:GridCopy.Member="ChangeText" Width="120" SortMemberPath="Change">
            <DataTemplate DataType="core:SnapshotDiffRow">
              <TextBlock Classes="cell mono" Text="{Binding ChangeText}" HorizontalAlignment="Right" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Status before" views:GridCopy.Member="BeforeStatus" Width="140" IsVisible="False">
            <DataTemplate DataType="core:SnapshotDiffRow">
              <TextBlock Classes="cell" Text="{Binding BeforeStatus}" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Status after" views:GridCopy.Member="AfterStatus" Width="140">
            <DataTemplate DataType="core:SnapshotDiffRow">
              <TextBlock Classes="cell" Text="{Binding AfterStatus}" />
            </DataTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Classes="empty-hint" IsVisible="{Binding !Rows.Count}"
                 Text="Nothing to show: no differences, or no snapshot yet (Watch ▸ Take Snapshot)." />
    </Grid>
  </DockPanel>
</Window>
