<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MachineDataBrowser.App.ViewModels"
        x:Class="MachineDataBrowser.App.Views.ValueDisplayWindow"
        x:DataType="vm:ValueDisplayViewModel"
        Title="Display format"
        Icon="/Assets/AppIcon.png"
        Width="480" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="14">
    <StackPanel Spacing="2">
      <TextBlock Text="{Binding Target}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="Display only: recordings, exports, filters and snapshots keep the device's value." FontSize="12"
                 TextWrapping="Wrap" Foreground="{DynamicResource AppMutedTextBrush}" />
    </StackPanel>

    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
      <TextBlock Text="Format" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <ComboBox ItemsSource="{x:Static vm:ValueDisplayViewModel.Formats}" SelectedItem="{Binding Format}" Width="150"
                  AutomationProperties.Name="Format"
                  ToolTip.Tip="Hex, Binary and Bits apply to integers; Bits lists the set bits of status words" />
        <NumericUpDown Value="{Binding Decimals}" Minimum="0" Maximum="15" Increment="1" FormatString="0" Width="110"
                       ButtonSpinnerLocation="Right" IsVisible="{Binding HasDecimals}" AutomationProperties.Name="Decimals" />
      </StackPanel>

      <TextBlock Grid.Row="1" Text="Scale" VerticalAlignment="Center" />
      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <TextBlock Text="×" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding Gain}" Increment="0.1" FormatString="0.######" Width="130" ButtonSpinnerLocation="Right"
                       AutomationProperties.Name="Gain" ToolTip.Tip="Shown value = value × gain + offset (e.g. raw 0…27648 → 0…100 %)" />
        <TextBlock Text="+" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding Offset}" Increment="1" FormatString="0.######" Width="130" ButtonSpinnerLocation="Right"
                       AutomationProperties.Name="Offset" />
      </StackPanel>

      <TextBlock Grid.Row="2" Text="Unit" VerticalAlignment="Center" />
      <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <CheckBox IsChecked="{Binding ShowUnit}" AutomationProperties.Name="Show unit" />
        <TextBox Text="{Binding Unit}" PlaceholderText="{Binding UnitPlaceholder}" Width="200" IsEnabled="{Binding ShowUnit}"
                 AutomationProperties.Name="Unit" ToolTip.Tip="Empty uses the server's engineering unit, when it has one" />
      </StackPanel>

      <TextBlock Grid.Row="3" Text="Preview" VerticalAlignment="Center" />
      <Border Grid.Row="3" Grid.Column="1" Background="{DynamicResource AppChipBrush}" CornerRadius="6" Padding="10,6">
        <TextBlock Text="{Binding Preview}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />
      </Border>
      <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RawText}" FontSize="12" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource AppMutedTextBrush}" />
    </Grid>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
      <Button Content="As sent" Click="OnDefault" MinWidth="80" ToolTip.Tip="No formatting, scaling or extra unit" />
      <Button Content="Cancel" IsCancel="True" Click="OnCancel" MinWidth="80" />
      <Button Content="Apply" IsDefault="True" Classes="accent" Click="OnApply" MinWidth="80" />
    </StackPanel>
  </StackPanel>
</Window>
