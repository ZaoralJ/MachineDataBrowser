<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MachineDataBrowser.App.ViewModels"
        x:Class="MachineDataBrowser.App.Views.NewRecordingWindow"
        x:DataType="vm:NewRecordingViewModel"
        Title="{Binding Title}"
        Icon="/Assets/AppIcon.png"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    </Style>
    <Style Selector="TextBlock.unit">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    </Style>
    <Style Selector="StackPanel:disabled > TextBlock.unit">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Grid.form > TextBlock, Grid.form > CheckBox">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="NumericUpDown.number">
      <Setter Property="Width" Value="150" />
      <Setter Property="FormatString" Value="0" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="16,12"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Cancel" IsCancel="True" Click="OnCancel" MinWidth="80" />
        <Button Content="{Binding ConfirmText}" IsDefault="True" Classes="accent" Click="OnStart" MinWidth="80" />
      </StackPanel>
    </Border>

    <StackPanel Margin="20,16,20,20" Spacing="10">
      <TextBlock Text="{Binding Summary}" Classes="hint" FontSize="13" />

      <TextBlock Text="SAMPLING" Classes="section" />
      <Grid Classes="form" ColumnDefinitions="170,*" RowDefinitions="Auto,Auto" RowSpacing="10">
        <TextBlock Text="Name" />
        <TextBox Grid.Column="1" Text="{Binding Name}" />

        <TextBlock Grid.Row="1" Text="Refresh" />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
          <NumericUpDown Classes="number" Value="{Binding RefreshMs}" Minimum="0" Maximum="3600000" Increment="50"
                         ToolTip.Tip="How often values are sampled; 0 = every change the server reports" />
          <TextBlock Text="ms" Classes="unit" />
        </StackPanel>
      </Grid>

      <TextBlock Text="IN MEMORY" Classes="section" />
      <Grid Classes="form" ColumnDefinitions="170,*" RowDefinitions="Auto,Auto" RowSpacing="10">
        <TextBlock Text="Max points per item" />
        <NumericUpDown Grid.Column="1" Classes="number" HorizontalAlignment="Left" Value="{Binding MaxPoints}" Minimum="1" Maximum="10000000" Increment="1000"
                       ToolTip.Tip="Older points are dropped from memory (and the chart) beyond this; a file keeps everything" />

        <CheckBox Grid.Row="1" Content="Keep only the last" IsChecked="{Binding LimitAge}" />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding LimitAge}">
          <NumericUpDown Classes="number" Value="{Binding MaxAgeMinutes}" Minimum="1" Maximum="100000" />
          <TextBlock Text="min" Classes="unit" />
        </StackPanel>
      </Grid>

      <TextBlock Text="SCHEDULE" Classes="section" />
      <Grid Classes="form" ColumnDefinitions="170,*" RowDefinitions="Auto,Auto" RowSpacing="10">
        <CheckBox Content="Start in" IsChecked="{Binding UseStartDelay}" IsEnabled="{Binding CanSchedule}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding UseStartDelay}">
          <NumericUpDown Classes="number" Value="{Binding StartDelayMinutes}" Minimum="0" Maximum="100000" />
          <TextBlock Text="min" Classes="unit" />
        </StackPanel>

        <CheckBox Grid.Row="1" Content="Stop after" IsChecked="{Binding UseStopAfter}" />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding UseStopAfter}">
          <NumericUpDown Classes="number" Value="{Binding StopAfterMinutes}" Minimum="1" Maximum="100000" />
          <TextBlock Text="min" Classes="unit" />
        </StackPanel>
      </Grid>

      <TextBlock Text="FILE" Classes="section" />
      <CheckBox Content="Also write every sample to a file" IsChecked="{Binding UseLiveFile}"
                ToolTip.Tip="Streams every sample to a file while recording, so long runs don't depend on memory: CSV, or a SQLite database for .db / .sqlite (queryable with SQL; each start adds a recording to the file)." />
      <StackPanel Spacing="8" IsVisible="{Binding UseLiveFile}" Margin="28,0,0,0">
        <TextBox Text="{Binding LiveFilePath}" PlaceholderText="history.db (SQLite) or history.csv" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="New File…" Click="OnPickFile" ToolTip.Tip="Create a new CSV or SQLite file" />
          <Button Content="Add to Existing…" Click="OnPickExistingFile"
                  ToolTip.Tip="Add this recording to an existing SQLite file (.db / .sqlite); the recordings in it are kept" />
        </StackPanel>
        <TextBlock Text="{Binding FileStatus}" Classes="hint" />
        <Grid Classes="form" ColumnDefinitions="142,*" IsVisible="{Binding IsSqliteFile}">
          <CheckBox Content="Keep in file" IsChecked="{Binding UseFileRetention}"
                    ToolTip.Tip="Samples older than this are deleted from the file (from every recording in it), so an always-on recording doesn't grow without end. Checked once a minute." />
          <StackPanel Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding UseFileRetention}">
            <NumericUpDown Classes="number" Value="{Binding FileRetentionDays}" Minimum="1" Maximum="36500" />
            <TextBlock Text="days" Classes="unit" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </StackPanel>
  </DockPanel>
</Window>
