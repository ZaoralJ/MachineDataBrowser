<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MachineDataBrowser.App.ViewModels"
        x:Class="MachineDataBrowser.App.Views.NewRecordingWindow"
        x:DataType="vm:NewRecordingViewModel"
        Title="{Binding Title}"
        Icon="/Assets/AppIcon.png"
        Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="16,12"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Cancel" IsCancel="True" Click="OnCancel" MinWidth="80" />
        <Button Content="{Binding ConfirmText}" IsDefault="True" Classes="accent" Click="OnStart" MinWidth="80" />
      </StackPanel>
    </Border>
    <StackPanel Margin="20" Spacing="14">
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" />
      <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
        <TextBlock Text="Name" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Name}" />

        <TextBlock Grid.Row="1" Text="Refresh (ms)" VerticalAlignment="Center" />
        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding RefreshMs}" Minimum="0" Maximum="3600000" Increment="50" FormatString="0" />

        <TextBlock Grid.Row="2" Text="Max points per item" VerticalAlignment="Center" />
        <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding MaxPoints}" Minimum="1" Maximum="10000000" Increment="1000" FormatString="0" />

        <CheckBox Grid.Row="3" Content="Keep last (min)" IsChecked="{Binding LimitAge}" />
        <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding MaxAgeMinutes}" Minimum="1" Maximum="100000" FormatString="0" IsEnabled="{Binding LimitAge}" />

        <CheckBox Grid.Row="4" Content="Start in (min)" IsChecked="{Binding UseStartDelay}" IsEnabled="{Binding CanSchedule}" />
        <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding StartDelayMinutes}" Minimum="0" Maximum="100000" FormatString="0" IsEnabled="{Binding UseStartDelay}" />

        <CheckBox Grid.Row="5" Content="Stop after (min)" IsChecked="{Binding UseStopAfter}" />
        <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding StopAfterMinutes}" Minimum="1" Maximum="100000" FormatString="0" IsEnabled="{Binding UseStopAfter}" />

        <CheckBox Grid.Row="6" Content="Also write to file" IsChecked="{Binding UseLiveFile}"
                  ToolTip.Tip="Streams every sample to a CSV file while recording, so long runs don't depend on memory." />
        <DockPanel Grid.Row="6" Grid.Column="1" IsEnabled="{Binding UseLiveFile}">
          <Button DockPanel.Dock="Right" Content="…" Click="OnPickFile" Margin="6,0,0,0" ToolTip.Tip="Choose file" />
          <TextBox Text="{Binding LiveFilePath}" PlaceholderText="history.csv" />
        </DockPanel>
      </Grid>
    </StackPanel>
  </DockPanel>
</Window>
