<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpcUaBrowser.App.ViewModels"
        xmlns:core="using:OpcUaBrowser.Core"
        xmlns:conv="using:OpcUaBrowser.App.Converters"
        x:Class="OpcUaBrowser.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <LayoutTransformControl x:Name="ZoomHost">
    <LayoutTransformControl.LayoutTransform>
      <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
    </LayoutTransformControl.LayoutTransform>
  <DockPanel>
    <NativeMenuBar DockPanel.Dock="Top" />

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Padding="12,8"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0" x:Name="EndpointBox" KeyDown="OnEndpointKeyDown"
                 Text="{Binding EndpointUrl}" IsEnabled="{Binding IsDisconnected}"
                 PlaceholderText="opc.tcp://host:4840" VerticalContentAlignment="Center"
                 FontFamily="{StaticResource MonoFont}"
                 AutomationProperties.Name="Server endpoint URL"
                 ToolTip.Tip="Server endpoint URL. Enter connects, ↓ shows recent endpoints.">
          <TextBox.InnerLeftContent>
            <TextBlock Text="Endpoint" Margin="10,0,4,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <Button x:Name="EndpointHistoryButton" Classes="icon-only" Margin="0,0,4,0"
                    IsVisible="{Binding HasRecentEndpoints}"
                    AutomationProperties.Name="Recent endpoints"
                    ToolTip.Tip="Recent endpoints (↓)">
              <PathIcon Data="{StaticResource IconChevronDown}" />
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <StackPanel Width="460" Spacing="4">
                    <TextBlock Classes="pane-title" Text="RECENT ENDPOINTS" Margin="4,0,0,4" />
                    <ItemsControl x:Name="EndpointHistoryList" ItemsSource="{Binding RecentEndpoints}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Grid ColumnDefinitions="*,Auto">
                            <Button Classes="history-entry" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).UseRecentEndpointCommand}"
                                    CommandParameter="{Binding}" ToolTip.Tip="Use this endpoint">
                              <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Button Grid.Column="1" Classes="icon-only"
                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveRecentEndpointCommand}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="Remove from history" ToolTip.Tip="Remove from history">
                              <PathIcon Data="{StaticResource IconClose}" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Separator />
                    <Button Classes="history-entry" Content="Clear history" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Command="{Binding ClearRecentEndpointsCommand}" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </TextBox.InnerRightContent>
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding ConnectCommand}" />
          </TextBox.KeyBindings>
        </TextBox>

        <Button Grid.Column="1" Classes="toolbar" IsEnabled="{Binding IsDisconnected}"
                AutomationProperties.Name="Connection options"
                ToolTip.Tip="Security, credentials and certificate options">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource IconOptions}" />
            <TextBlock Text="{Binding OptionsSummary}" VerticalAlignment="Center" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Width="300" Spacing="12" Margin="4">
                <TextBlock Text="Connection options" FontWeight="SemiBold" />
                <StackPanel Spacing="4">
                  <TextBlock Text="Default refresh time (ms)" />
                  <NumericUpDown Value="{Binding DefaultRefreshMs}" Minimum="0" Maximum="3600000" Increment="50"
                                 FormatString="0"
                                 ToolTip.Tip="Sampling and publishing interval for items monitored in this session. Saved with the session; individual items can be changed by right-click." />
                </StackPanel>
                <CheckBox Content="Use secure endpoint" IsChecked="{Binding UseSecurity}"
                          ToolTip.Tip="Pick the most secure endpoint the server offers (Sign &amp; Encrypt)" />
                <StackPanel Spacing="4">
                  <TextBlock Text="User name" />
                  <TextBox Text="{Binding UserName}" PlaceholderText="Anonymous if empty" />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Password" />
                  <TextBox Text="{Binding Password}" PasswordChar="•" />
                </StackPanel>
                <Separator />
                <CheckBox Classes="insecure" IsChecked="{Binding AutoAcceptCertificates}"
                          ToolTip.Tip="Server certificates are trusted without verification. Only use on isolated lab networks.">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconWarning}" Width="14" Height="14"
                              Foreground="{StaticResource StatusUncertainBrush}" />
                    <TextBlock Text="Auto-trust server certificates (insecure)" />
                  </StackPanel>
                </CheckBox>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>

        <Button Grid.Column="2" Classes="toolbar accent" Command="{Binding ConnectCommand}"
                IsVisible="{Binding !IsConnected}"
                AutomationProperties.Name="Connect" ToolTip.Tip="Connect to the server (Enter)">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource IconConnect}" />
            <TextBlock Text="Connect" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="toolbar" Command="{Binding DisconnectCommand}"
                IsVisible="{Binding IsConnected}"
                AutomationProperties.Name="Disconnect" ToolTip.Tip="Close the session">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource IconDisconnect}" />
            <TextBlock Text="Disconnect" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <ProgressBar Grid.Column="3" IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                     Width="80" MinWidth="80" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Error banner -->
    <Border DockPanel.Dock="Top" Classes="error-banner" IsVisible="{Binding HasError}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="icon-only" Command="{Binding DismissErrorCommand}"
                AutomationProperties.Name="Dismiss error" ToolTip.Tip="Dismiss">
          <PathIcon Data="{StaticResource IconClose}" />
        </Button>
        <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconError}" Width="16" Height="16"
                  Margin="0,0,8,0" Foreground="{StaticResource StatusBadBrush}" />
        <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="12,4"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                   Fill="{Binding State, Converter={x:Static conv:ConnectionStateConverters.ToBrush}}" />
          <TextBlock Text="{Binding State, Converter={x:Static conv:ConnectionStateConverters.ToText}}"
                     FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" />
      </DockPanel>
    </Border>

    <DockControl x:Name="DockHost" Layout="{Binding Layout}" Factory="{Binding DockFactory}"
                 InitializeFactory="True" InitializeLayout="True" />
  </DockPanel>
  </LayoutTransformControl>
</Window>
