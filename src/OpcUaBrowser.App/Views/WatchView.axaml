<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:OpcUaBrowser.App.Views"
             xmlns:vm="using:OpcUaBrowser.App.ViewModels"
             xmlns:core="using:OpcUaBrowser.Core"
             xmlns:conv="using:OpcUaBrowser.App.Converters"
             x:Class="OpcUaBrowser.App.Views.WatchView"
             x:DataType="vm:MainWindowViewModel">
  <DockPanel Background="Transparent" DragDrop.AllowDrop="True">
    <Border DockPanel.Dock="Top" Classes="pane-toolbar">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,4,0">
          <TextBlock Text="{Binding WatchFilterSummary}" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource AppMutedTextBrush}" />
          <TextBox x:Name="FilterBox" Text="{Binding WatchFilter}" Width="220" Classes="search"
                   PlaceholderText="Filter name, id, value, status (/)" AutomationProperties.Name="Filter watch list"
                   ToolTip.Tip="Shows only rows whose name, NodeId, value or status contains the text. Esc clears.">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Escape" Command="{Binding ClearWatchFilterCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <ToggleButton IsChecked="{Binding ShowWatchProblemsOnly}" Content="Problems only"
                        ToolTip.Tip="Show only Bad, Uncertain or stale rows (P)" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button x:Name="ColumnsButton" Classes="icon-only" AutomationProperties.Name="Columns"
                  ToolTip.Tip="Show/hide columns (saved with the session). Drag headers to reorder, edges to resize.">
            <PathIcon Data="{StaticResource IconColumns}" />
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Spacing="2" MinWidth="180">
                  <TextBlock Classes="pane-title" Text="COLUMNS" Margin="8,0,0,6" />
                  <ItemsControl ItemsSource="{Binding WatchColumns.Columns}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WatchColumnOption">
                        <CheckBox Content="{Binding Header}" IsChecked="{Binding IsVisible}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Separator />
                  <Button Classes="history-entry" Content="Reset columns" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left" Command="{Binding ResetWatchColumnsCommand}" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Classes="icon-only" Command="{Binding SelectStaleCommand}" DoubleTapped="OnRemoveStaleDoubleTapped"
                  AutomationProperties.Name="Select stale values"
                  ToolTip.Tip="Select stale values: items without an update for 5× their refresh time (at least 5 s), or never updated. Double-click removes them.">
            <PathIcon Data="{StaticResource IconStale}" />
          </Button>
          <Button Classes="icon-only" Command="{Binding SelectBadCommand}" DoubleTapped="OnRemoveBadDoubleTapped"
                  AutomationProperties.Name="Select bad values"
                  ToolTip.Tip="Select bad values: items whose latest status is Bad. Double-click removes them.">
            <PathIcon Data="{StaticResource IconError}" />
          </Button>
          <Button Classes="icon-only" Command="{Binding AddToWatchCommand}"
                  AutomationProperties.Name="Add selected node to watch"
                  ToolTip.Tip="Add selected variable (Enter or double-click in tree)">
            <PathIcon Data="{StaticResource IconAdd}" />
          </Button>
          <Button Classes="icon-only" Command="{Binding RemoveFromWatchCommand}"
                  AutomationProperties.Name="Remove from watch"
                  ToolTip.Tip="Remove selected items (Delete). Cmd/Ctrl- or Shift-click to select several.">
            <PathIcon Data="{StaticResource IconRemove}" />
          </Button>
          <Button Classes="icon-only" Command="{Binding ClearWatchCommand}"
                  AutomationProperties.Name="Remove all from watch"
                  ToolTip.Tip="Remove all items from the watch list">
            <PathIcon Data="{StaticResource IconClearAll}" />
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid>
      <DataGrid x:Name="WatchGrid" DoubleTapped="OnRowDoubleTapped" DragDrop.AllowDrop="True" Background="Transparent" ItemsSource="{Binding WatchView}" SelectedItem="{Binding SelectedWatchItem}"
                SelectionMode="Extended" SelectionChanged="OnWatchSelectionChanged"
                AutomationProperties.Name="Watch list">
        <DataGrid.ContextMenu>
          <ContextMenu>
              <MenuItem Header="{Binding WatchSelectionLabel, StringFormat='Refresh time{0}'}" IsEnabled="{Binding IsConnected}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconTimer}" /></MenuItem.Icon>
              <MenuItem Header="100 ms" Command="{Binding SetRefreshCommand}"><MenuItem.CommandParameter><x:Int32>100</x:Int32></MenuItem.CommandParameter></MenuItem>
              <MenuItem Header="250 ms" Command="{Binding SetRefreshCommand}"><MenuItem.CommandParameter><x:Int32>250</x:Int32></MenuItem.CommandParameter></MenuItem>
              <MenuItem Header="500 ms" Command="{Binding SetRefreshCommand}"><MenuItem.CommandParameter><x:Int32>500</x:Int32></MenuItem.CommandParameter></MenuItem>
              <MenuItem Header="1 s" Command="{Binding SetRefreshCommand}"><MenuItem.CommandParameter><x:Int32>1000</x:Int32></MenuItem.CommandParameter></MenuItem>
              <MenuItem Header="2 s" Command="{Binding SetRefreshCommand}"><MenuItem.CommandParameter><x:Int32>2000</x:Int32></MenuItem.CommandParameter></MenuItem>
              <MenuItem Header="5 s" Command="{Binding SetRefreshCommand}"><MenuItem.CommandParameter><x:Int32>5000</x:Int32></MenuItem.CommandParameter></MenuItem>
              <MenuItem Header="10 s" Command="{Binding SetRefreshCommand}"><MenuItem.CommandParameter><x:Int32>10000</x:Int32></MenuItem.CommandParameter></MenuItem>
              <Separator />
              <MenuItem Header="Custom…" Click="OnCustomRefresh" Tag="watch" />
            </MenuItem>
            <MenuItem Header="{Binding WatchSelectionLabel, StringFormat='Monitoring settings…{0}'}" Command="{Binding EditMonitoringCommand}"
                      IsVisible="{Binding SupportsMonitoringSettings}"
                      ToolTip.Tip="Sampling interval, queue size and deadband (OPC UA)" />
            <MenuItem Header="{Binding WatchSelectionLabel, StringFormat='Record selected…{0}'}" Command="{Binding NewRecordingCommand}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconRecord}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Record all monitored…" Command="{Binding RecordAllCommand}" />
            <MenuItem Header="{Binding WatchSelectionLabel, StringFormat='Add to recording{0}'}" ItemsSource="{Binding Recordings}"
                      IsEnabled="{Binding !!Recordings.Count}"
                      ToolTip.Tip="Record the selected rows in an existing recording too; a running recording starts capturing them at once">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconRecord}" /></MenuItem.Icon>
              <MenuItem.Styles>
                <Style Selector="MenuItem > MenuItem" x:DataType="vm:RecordingViewModel">
                  <Setter Property="Header" Value="{Binding Name}" />
                  <Setter Property="Command" Value="{Binding $parent[ContextMenu].((vm:MainWindowViewModel)DataContext).AddToRecordingCommand}" />
                  <Setter Property="CommandParameter" Value="{Binding}" />
                </Style>
              </MenuItem.Styles>
            </MenuItem>
            <MenuItem Header="Show recorded values" Command="{Binding ViewItemRecordingCommand}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconChart}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{Binding WatchSelectionLabel, StringFormat='Show history{0}'}" IsVisible="{Binding SupportsHistory}"
                      ToolTip.Tip="Values the server stored for these items (OPC UA HistoryRead), as a table and chart">
              <MenuItem Header="Last 15 minutes" Command="{Binding ShowWatchHistoryCommand}"><MenuItem.CommandParameter><x:Int32>15</x:Int32></MenuItem.CommandParameter></MenuItem>
              <MenuItem Header="Last hour" Command="{Binding ShowWatchHistoryCommand}"><MenuItem.CommandParameter><x:Int32>60</x:Int32></MenuItem.CommandParameter></MenuItem>
              <MenuItem Header="Last 8 hours" Command="{Binding ShowWatchHistoryCommand}"><MenuItem.CommandParameter><x:Int32>480</x:Int32></MenuItem.CommandParameter></MenuItem>
              <MenuItem Header="Last 24 hours" Command="{Binding ShowWatchHistoryCommand}"><MenuItem.CommandParameter><x:Int32>1440</x:Int32></MenuItem.CommandParameter></MenuItem>
              <MenuItem Header="Last 7 days" Command="{Binding ShowWatchHistoryCommand}"><MenuItem.CommandParameter><x:Int32>10080</x:Int32></MenuItem.CommandParameter></MenuItem>
            </MenuItem>
            <Separator />
            <MenuItem Header="Show in address space" Command="{Binding RevealInTreeCommand}" />
            <MenuItem Header="Select">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconStale}" /></MenuItem.Icon>
              <MenuItem Header="Stale values" Command="{Binding SelectStaleCommand}" />
              <MenuItem Header="Bad values" Command="{Binding SelectBadCommand}" />
              <MenuItem Header="Stale or bad values" Command="{Binding SelectStaleOrBadCommand}" />
            </MenuItem>
            <Separator />
            <MenuItem Header="{Binding WatchSelectionLabel, StringFormat='Write value…{0}'}" Command="{Binding WriteWatchValueCommand}" />
            <Separator />
            <MenuItem Header="{Binding WatchSelectionLabel, StringFormat='Copy value{0}'}" Command="{Binding CopyWatchValueCommand}" />
            <MenuItem Header="{Binding WatchSelectionLabel, StringFormat='Copy NodeId{0}'}" Command="{Binding CopyWatchNodeIdCommand}" />
            <MenuItem Header="{Binding WatchSelectionLabel, StringFormat='Copy values as JSON{0}'}" Command="{Binding CopyWatchValuesJsonCommand}" ToolTip.Tip="Typed values only: one value, or an object keyed by name" />
            <MenuItem Header="{Binding WatchSelectionLabel, StringFormat='Copy as JSON{0}'}" Command="{Binding CopyWatchJsonCommand}" />
            <Separator />
            <MenuItem Header="{Binding WatchSelectionLabel, StringFormat='Remove selected{0}'}" Command="{Binding RemoveFromWatchCommand}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconRemove}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Remove all" Command="{Binding ClearWatchCommand}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconClearAll}" /></MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Name" views:GridCopy.Member="DisplayName" Width="190" MinWidth="80" SortMemberPath="DisplayName">
            <DataTemplate DataType="vm:WatchItemViewModel">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="icon-only row-history" IsVisible="{Binding HasRecording}"
                        Command="{Binding $parent[DataGrid].((vm:MainWindowViewModel)DataContext).ViewItemRecordingCommand}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="Show recorded values"
                        ToolTip.Tip="Show recorded values (with a trend chart for numbers)">
                  <PathIcon Data="{StaticResource IconChart}" />
                </Button>
                <PathIcon DockPanel.Dock="Right" Classes="recording-dot" Data="{StaticResource IconRecord}"
                          Width="10" Height="10" Margin="0,0,4,0" IsVisible="{Binding IsRecording}"
                          ToolTip.Tip="{Binding RecordingToolTip}" AutomationProperties.Name="Recorded" />
                <TextBlock Classes="cell" Text="{Binding DisplayName}" ToolTip.Tip="{Binding NodeIdText}" />
              </DockPanel>
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="NodeId" views:GridCopy.Member="NodeIdText" Width="210" MinWidth="80" SortMemberPath="NodeIdText">
            <DataTemplate DataType="vm:WatchItemViewModel">
              <TextBlock Classes="cell mono" Text="{Binding NodeIdText}"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Status" views:GridCopy.Member="Status" Width="180" MinWidth="70" SortMemberPath="Status">
            <DataTemplate DataType="vm:WatchItemViewModel">
              <Border Classes="status-badge" Margin="10,0,6,0"
                      IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      Classes.status-bad="{Binding IsBad}"
                      Classes.status-uncertain="{Binding IsUncertain}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse Width="6" Height="6" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                             Classes.status-bad="{Binding IsBad}"
                             Classes.status-uncertain="{Binding IsUncertain}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Refresh" views:GridCopy.Member="RefreshText" Width="100" MinWidth="80" SortMemberPath="RefreshMs">
            <DataTemplate DataType="vm:WatchItemViewModel">
              <TextBlock Classes="cell mono" Text="{Binding RefreshText}" HorizontalAlignment="Right"
                         ToolTip.Tip="{Binding RefreshToolTip}" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Last update" views:GridCopy.Member="LastUpdateText" Width="136" MinWidth="110" SortMemberPath="LastUpdate">
            <DataTemplate DataType="vm:WatchItemViewModel">
              <TextBlock Classes="cell mono" Text="{Binding LastUpdateText}" HorizontalAlignment="Right"
                         ToolTip.Tip="Local time the latest notification arrived" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Since" views:GridCopy.Member="SinceText" Width="112" MinWidth="80" SortMemberPath="LastUpdate">
            <DataTemplate DataType="vm:WatchItemViewModel">
              <TextBlock Classes="cell" Text="{Binding SinceText}" HorizontalAlignment="Right"
                         Classes.status-uncertain="{Binding IsStale}">
                <ToolTip.Tip>
                  <TextBlock>
                    <Run Text="Updates received: " /><Run Text="{Binding UpdateCount}" />
                    <LineBreak /><Run Text="Amber = no change for 5× the refresh time (value may just be constant)." />
                  </TextBlock>
                </ToolTip.Tip>
              </TextBlock>
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Recorded" views:GridCopy.Member="RecordedText" Width="100" MinWidth="86" SortMemberPath="RecordedSamples">
            <DataTemplate DataType="vm:WatchItemViewModel">
              <TextBlock Classes="cell mono" Text="{Binding RecordedText}" HorizontalAlignment="Right"
                         ToolTip.Tip="Samples in the newest recording of this item. Double-click the row to show them." />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Source time" views:GridCopy.Member="SourceTimestamp" Width="136" MinWidth="110">
            <DataTemplate DataType="vm:WatchItemViewModel">
              <TextBlock Classes="cell mono" Text="{Binding SourceTimestamp}" HorizontalAlignment="Right" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Value" views:GridCopy.Member="Value" Width="280" MinWidth="120">
            <DataTemplate DataType="vm:WatchItemViewModel">
              <TextBlock Classes="cell mono" Text="{Binding Value}" ToolTip.Tip="{Binding Value}" />
            </DataTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Classes="empty-hint" IsVisible="{Binding !HasWatchItems}"
                 Text="Drag variables or folders here from the address space, or double-click a variable, to watch live values." />
    </Grid>
  </DockPanel>
</UserControl>
