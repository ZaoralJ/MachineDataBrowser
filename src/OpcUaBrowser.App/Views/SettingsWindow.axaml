<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpcUaBrowser.App.ViewModels"
        xmlns:svc="using:OpcUaBrowser.App.Services"
        x:Class="OpcUaBrowser.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Icon="/Assets/AppIcon.png"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="16,12"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Cancel" HorizontalContentAlignment="Center" MinHeight="32" IsCancel="True" Click="OnCancel" MinWidth="80" />
        <Button Content="Save" HorizontalContentAlignment="Center" MinHeight="32" IsDefault="True" Classes="accent" Click="OnSave" MinWidth="80" />
      </StackPanel>
    </Border>

    <StackPanel Margin="24,20" Spacing="22">
      <StackPanel Spacing="8">
        <TextBlock Classes="pane-title" Text="APPEARANCE" />
        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto">
          <TextBlock Text="Theme" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" Width="180" HorizontalAlignment="Left"
                    ItemsSource="{x:Static vm:SettingsViewModel.Themes}" SelectedItem="{Binding Theme}"
                    AutomationProperties.Name="Theme" />
        </Grid>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Classes="pane-title" Text="MONITORING" />
        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto" RowSpacing="10">
          <TextBlock Text="Default refresh" VerticalAlignment="Center" />
          <NumericUpDown ButtonSpinnerLocation="Right" Width="180" HorizontalAlignment="Left" Grid.Column="1" Value="{Binding SamplingIntervalMs}" Minimum="0" Maximum="60000"
                         Increment="50" FormatString="0 'ms'" AutomationProperties.Name="Sampling interval"
                         ToolTip.Tip="Default refresh time for new connections/sessions. Each session can override it in Connection options." />
          <TextBlock Grid.Row="1" Text="Recursive monitor limit" VerticalAlignment="Center" />
          <NumericUpDown ButtonSpinnerLocation="Right" Width="180" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="1" Value="{Binding MaxRecursiveItems}" Minimum="1" Maximum="10000"
                         Increment="100" FormatString="0 'items'" AutomationProperties.Name="Recursive monitor limit"
                         ToolTip.Tip="Maximum number of variables added by 'Monitor all variables in folder'." />
        </Grid>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Classes="pane-title" Text="STARTUP" />
        <CheckBox Content="Reopen last session on start" IsChecked="{Binding ReopenLastSession}" />
      </StackPanel>
    </StackPanel>
  </DockPanel>
</Window>
