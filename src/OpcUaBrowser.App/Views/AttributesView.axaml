<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpcUaBrowser.App.ViewModels"
             xmlns:core="using:OpcUaBrowser.Core"
             xmlns:conv="using:OpcUaBrowser.App.Converters"
             x:Class="OpcUaBrowser.App.Views.AttributesView"
             x:DataType="vm:MainWindowViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="pane-toolbar" IsVisible="{Binding IsSelectedValueLive}">
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="6,0">
        <Ellipse Width="7" Height="7" Fill="{StaticResource StatusGoodBrush}" VerticalAlignment="Center" />
        <TextBlock FontSize="12" VerticalAlignment="Center"
                   Text="{Binding DefaultRefreshMs, StringFormat='Value updates live every {0} ms (default refresh)'}" />
      </StackPanel>
    </Border>
    <Grid>
      <DataGrid ItemsSource="{Binding Attributes}" SelectedItem="{Binding SelectedAttribute}"
                CanUserSortColumns="False" AutomationProperties.Name="Attributes">
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Copy value" Command="{Binding CopyAttributeValueCommand}" />
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Attribute" Width="180" MinWidth="80">
            <DataTemplate DataType="core:AttributeValue">
              <TextBlock Classes="cell" Text="{Binding Name}"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Value" Width="*" MinWidth="120">
            <DataTemplate DataType="core:AttributeValue">
              <TextBlock Classes="cell mono" Text="{Binding Value}" ToolTip.Tip="{Binding Value}" />
            </DataTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Classes="empty-hint" IsVisible="{Binding !HasAttributes}"
                 Text="Select a node to see its attributes." />
    </Grid>
  </DockPanel>
</UserControl>
